APP_PORT=8088
BIND_ADDRESS=127.0.0.1
POSTGRES_PASSWORD=lexa-local-change-me
# Empty password is allowed only for a trusted local/private deployment.
APP_PASSWORD=
COOKIE_SECURE=false
# Optional: OpenRouter, OpenAI, Ollama or another compatible endpoint. Empty URL/model = source search mode.
# auto detects openrouter.ai; use openrouter explicitly for a proxy/test endpoint.
LLM_PROVIDER=auto
LLM_BASE_URL=
LLM_API_KEY=
# Separate credential: LLM_API_KEY is never used by the OpenRouter adapter.
OPENROUTER_API_KEY=
LLM_MODEL=
# Default chat architecture; API requests and test scripts can override it.
RAG_ARCHITECTURE=agentic
# Rig model-call budget for the research phase (1–12).
RAG_MAX_TURNS=6
# Recommended native OpenAI example (GPT-6.1 Sol, max reasoning in every phase):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-6.1-sol
# LLM_API_KEY=your-openai-api-key
# Alternative OpenRouter example (DeepSeek uses Chat, max reasoning, CoreWeave/Together and strict JSON schemas):
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-v4.1-flash
# OPENROUTER_API_KEY=your-openrouter-api-key
# To compare Qwen using the same account, change only the model:
# LLM_MODEL=qwen/qwen3.8-27b
# Example for an Ollama instance running on your Docker host:
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen3:8b

# Optional semantic search; independent of the chat model. Empty = lexical search.
# Endpoint must support POST /v1/embeddings with array inputs and float vectors.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# Set prefixes required by your selected model, including any trailing space.
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=
# Bump when replacing model weights under the same model name.
EMBEDDING_REVISION=
# Cosine similarity cutoff; tune against representative Slovak questions.
EMBEDDING_MIN_SIMILARITY=0.35
# Example for an existing local Ollama embedding model:
# EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_QUERY_PREFIX="search_query: "
# EMBEDDING_DOCUMENT_PREFIX="search_document: "
